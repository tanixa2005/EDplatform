# ==============================================================================
# EDplatform Monorepo Environment Variables (Template)
# ==============================================================================

# Backend (apps/backend/.env)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edplatform?schema=public"
JWT_SECRET="edplatform-development-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Cookie Security Settings (Environment-Aware)
# In production set COOKIE_SECURE=true and COOKIE_SAME_SITE=lax (or none if cross-origin)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Google Gemini API
GEMINI_API_KEY=""

# Frontend (apps/frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edplatform?schema=public"
JWT_SECRET="edplatform-development-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Cookie Security Settings (Environment-Aware)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# External AI is OFF unless AI_TUTOR_MODE=live. Unset (or any other value)
# means paused: no request is sent to any AI provider, students see a short
# "paused" message, and quiz analysis uses the local, non-AI version. No key
# is needed while paused, in development or production.
# For local development with the offline Mock tutor, set AI_TUTOR_MODE=live and
# leave OPENROUTER_API_KEY empty. A key together with live sends requests to
# OpenRouter.
AI_TUTOR_MODE=
OPENROUTER_API_KEY=

GEMINI_API_KEY=""

# Clerk authentication (get these from https://dashboard.clerk.com)
# While these are unset the backend falls back to the legacy JWT cookie, so the
# existing login keeps working during the migration.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Signing secret for the Clerk user.created / user.updated / user.deleted webhook
CLERK_WEBHOOK_SECRET=

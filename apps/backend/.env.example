PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edplatform?schema=public"
JWT_SECRET="edplatform-development-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Cookie Security Settings (Environment-Aware)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

GEMINI_API_KEY=""

# Clerk authentication (get these from https://dashboard.clerk.com)
# While these are unset the backend falls back to the legacy JWT cookie, so the
# existing login keeps working during the migration.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Signing secret for the Clerk user.created / user.updated / user.deleted webhook
CLERK_WEBHOOK_SECRET=

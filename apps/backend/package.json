{
  "name": "@edplatform/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace=@edplatform/shared && prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "pretest": "node scripts/db-guard.mjs --print",
    "test": "tsx src/__tests__/verify_phase7_security.ts && tsx src/__tests__/verify_ed_voice.ts",
    "pretest:security": "node scripts/db-guard.mjs --print",
    "test:security": "tsx src/__tests__/verify_phase7_security.ts",
    "pretypecheck": "npm run build --workspace=@edplatform/shared && prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/db-guard.mjs migrate deploy",
    "db": "node scripts/db-guard.mjs",
    "db:check": "node scripts/db-guard.mjs --print",
    "db:status": "node scripts/db-guard.mjs migrate status",
    "db:deploy": "node scripts/db-guard.mjs migrate deploy",
    "db:diff": "node scripts/db-guard.mjs migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "test:voice": "tsx src/__tests__/verify_ed_voice.ts",
    "test:production-seed": "tsx src/__tests__/verify_production_seed.ts",
    "test:cors": "tsx src/__tests__/verify_cors.ts",
    "test:offline-demo": "tsx src/__tests__/verify_offline_demo.ts",
    "test:public-catalog": "tsx src/__tests__/verify_public_catalog.ts",
    "test:demo-bootstrap": "tsx src/__tests__/verify_demo_bootstrap.ts",
    "demo:bootstrap": "tsx src/tools/demo-curriculum/cli.ts",
    "test:account-linking": "tsx src/__tests__/verify_account_linking.ts",
    "test:demo-entry-guard": "tsx src/__tests__/verify_demo_entry_guard.ts",
    "test:auth-middleware": "tsx src/__tests__/verify_auth_middleware.ts",
    "test:webhook-handler": "tsx src/__tests__/verify_webhook_handler.ts",
    "predb:seed:curriculum": "node scripts/db-guard.mjs --print",
    "db:seed:curriculum": "tsx prisma/seed-curriculum.ts",
    "predb:seed:lessons": "node scripts/db-guard.mjs --print",
    "db:seed:lessons": "tsx prisma/seed-curriculum-lessons.ts",
    "predb:seed:quiz": "node scripts/db-guard.mjs --print",
    "db:seed:quiz": "tsx prisma/seed-curriculum-quiz.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.7",
    "@edplatform/shared": "*",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^5.21.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.8.7",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "prisma": "^5.21.1",
    "sharp": "^0.35.5",
    "svix": "^2.6.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}

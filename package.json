{
  "name": "edplatform-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready AI Education Platform (EDplatform)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=@edplatform/shared && npm run prisma:generate --workspace=@edplatform/backend && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/backend",
    "lint": "eslint .",
    "db:check": "npm run db:check --workspace=@edplatform/backend",
    "db:status": "npm run db:status --workspace=@edplatform/backend",
    "db:deploy": "npm run db:deploy --workspace=@edplatform/backend",
    "db:diff": "npm run db:diff --workspace=@edplatform/backend",
    "db:seed:curriculum": "npm run db:seed:curriculum --workspace=@edplatform/backend",
    "db:seed:lessons": "npm run db:seed:lessons --workspace=@edplatform/backend",
    "db:seed:quiz": "npm run db:seed:quiz --workspace=@edplatform/backend"
  },
  "keywords": [
    "education",
    "ai",
    "nextjs",
    "express",
    "prisma",
    "openrouter"
  ],
  "author": "EDplatform Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
